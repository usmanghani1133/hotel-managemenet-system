# ============================================================
# Hotel Management System - .gitignore
# ============================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production & Build outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
**/out/

# Environment variables & Sensitive files
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example
*.local
*.pem
*.key
*.cert
*.p12

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache & Temporary files
.cache/
**/.cache/
*.cache
.eslintcache
.stylelintcache
.oxlintcache
.vite/
**/.vite/
.turbo/
.parcel-cache/
.rollup.cache/

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
